{
  "ConnectionStrings": {
    "PracticeDB": "Data Source=*ServiceName*;Initial Catalog=*DBScema*;User ID=*USER*;Password=*********;Pooling=false;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "FormBuilderDB"
  },

  "PdfRenderer": {
    // Root of the frontend build output (formio.full.min.js, formio.full.css). Relative
    // paths resolve against the content root.
    "AssetsPath": "wwwroot/pdf/dist",

    // Root of the frontend app assets: vendored bootstrap/jquery, custom css.
    "AppAssetsPath": "wwwroot/pdf/app",

    // Folder holding the render harness (render.html) shipped with the API itself.
    "EnginePath": "wwwroot/pdf-engine",

    // Form.io bundle to load, relative to AssetsPath.
    "FormioScript": "formio.full.min.js",

    // Form.io stylesheet to load, relative to AssetsPath.
    "FormioStylesheet": "formio.full.css",

    // Synthetic host the headless browser navigates to. Every request to this host is
    // intercepted and answered from disk - no real web server or network hop involved.
    "VirtualHost": "formbuilder-pdf.local",

    // Allow the page to fetch real http(s) resources it doesn't serve itself (e.g. a
    // submission image hosted on a CDN). Off by default: an unreachable third-party host
    // would otherwise stall the render and hold a concurrency slot until RenderTimeoutMs.
    // Turn on only if forms genuinely need remote assets.
    "AllowExternalResources": false,

    // Run Chromium headless. Only set false when debugging the render locally with a
    // visible browser window.
    "Headless": true,

    // Download the Chromium build automatically the first time it's missing, instead of
    // failing and requiring a manual "playwright install chromium".
    "AutoInstallBrowser": true,

    // Max time to wait for render.html to navigate/load, in milliseconds.
    // in headless chromium.
    "NavigationTimeoutMs": 60000,

    //whenever we generate a pdf ,how long pdf can process to generate
    "RenderTimeoutMs": 180000,

    // Pause the harness waits after each render step for layout to settle before the
    // next measurement (page-break calculation, tab flattening), in milliseconds.
    //while rendering the pdf
    "RenderSettleDelayMs": 400,

    // How long Chromium itself is given to start up before the launch attempt is
    // considered failed, in seconds.
    "BrowserLaunchTimeoutSeconds": 120,

    // Max number of renders running at the same time. Each one costs a browser context
    // (~40-60 MB), so this is the main memory/CPU control on a busy server.
    // Numer of slots to process the pdf generation.
    "MaxConcurrentRenders": 2,

    // how long a request pdf should wait for slot
    "QueueWaitTimeoutSeconds": 30,

    //Maximum number of rqeust pdfs allowed in a queue
    "MaxSubmissionsPerRequest": 20,

    //MOBILE =375 ,Tablet= 768PX, Desktop=992,
    //this is for responsive design view
    "MinContentWidthPx": 992,

    // Default paper settings; a request's own "page" object overrides these per-call.
    "Page": {
      "Format": "A4", // A3, A4, A5, Letter, Legal or Tabloid
      "MarginTop": "12mm",
      "MarginRight": "10mm",
      "MarginBottom": "16mm", // extra room for the footer
      "MarginLeft": "10mm"
    },


    "AcroForm": {
      // true  - pdf render and look just like html form.
      // false - the classic AcroForm look. all elements are highlighted and have borders.
      "TransparentFields": true
    },

    "HeaderFooter": {
      "Enabled": true,
      "ShowPrintedDate": true, // left side of the footer
      "ShowPageNumbers": true, // right side: "Page X of Y"
      "DateFormat": "dd MMM yyyy HH:mm"
    }
  }
}
