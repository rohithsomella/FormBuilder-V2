{
  "ConnectionStrings": {
    "PracticeDB": "Data Source=CALAP-312;Initial Catalog=FormBuilderApp;User ID=sa;Password=Access2018$;Pooling=false;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "FormBuilderDB"
  },

  "PdfRenderer": {
    "Mode": "Production", 
    "AssetsPath": "wwwroot/pdf/dist",
    "AppAssetsPath": "wwwroot/pdf/app",
    "EnginePath": "wwwroot/pdf-engine",
    "FormioScript": "formio.full.min.js",
    "FormioStylesheet": "formio.full.css",
    "VirtualHost": "formbuilder-pdf.local",
    "AllowExternalResources": false,
    "Headless": true,
    "AutoInstallBrowser": true,
    "NavigationTimeoutMs": 60000,
    "RenderTimeoutMs": 180000,
    "RenderSettleDelayMs": 400,
    "BrowserLaunchTimeoutSeconds": 120,
    "MaxConcurrentRenders": 2,
    "QueueWaitTimeoutSeconds": 30,
    "MaxSubmissionsPerRequest": 20,
    "MinContentWidthPx": 992,
    "Page": {
      "Format": "A4",
      "Landscape": false,
      "MarginTop": "12mm",
      "MarginRight": "10mm",
      "MarginBottom": "16mm",
      "MarginLeft": "10mm",
      "Scale": 1,
      "PrintBackground": true
    },
    "HeaderFooter": {
      "Enabled": true,
      "ShowPrintedDate": true,
      "ShowPageNumbers": true,
      "PrintedDateLabel": "Printed",
      "DateFormat": "dd MMM yyyy HH:mm"
    }
  }
}
